# Clerk — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Optional Clerk URL helpers (defaults work with this repo's routes)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Convex — set automatically by `npx convex dev` / `pnpm dev`
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ---------------------------------------------------------------------------
# Also set these in the Convex Dashboard → Settings → Environment Variables
# (not in .env.local):
#
#   CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-frontend-api.clerk.accounts.dev
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   APP_URL=http://localhost:3000
